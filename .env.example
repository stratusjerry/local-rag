# Local RAG Configuration
# Copy this file to .env and adjust values as needed

# Directory containing documents to ingest
RAG_DOCUMENTS_DIR=files

# ChromaDB persistent storage path
RAG_CHROMA_DB_PATH=output/chromadb

# ChromaDB collection name
RAG_COLLECTION_NAME=local_rag

# Embedding provider: "ollama" or "sentence_transformers"
RAG_EMBEDDING_PROVIDER=ollama

# Embedding model name
RAG_EMBEDDING_MODEL=nomic-embed-text

# LLM provider: "ollama", "lmstudio", or "bedrock"
RAG_LLM_PROVIDER=ollama

# LLM model name (used by ollama and lmstudio)
RAG_LLM_MODEL=llama3.2

# Chunk size in characters
RAG_CHUNK_SIZE=1000

# Chunk overlap in characters
RAG_CHUNK_OVERLAP=200

# Number of top results to retrieve
RAG_TOP_K=5

# LLM temperature (0.0 - 1.0)
RAG_TEMPERATURE=0.7

# --- LM Studio ---
RAG_LMSTUDIO_URL=http://localhost:1234/v1

# --- AWS Bedrock ---
RAG_BEDROCK_REGION=us-east-1
RAG_BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-4-5-v1
RAG_BEDROCK_ACCESS_KEY=
RAG_BEDROCK_SECRET_KEY=
RAG_BEDROCK_SESSION_TOKEN=
# Custom endpoint URL for isolated/air-gapped regions (leave blank for default)
RAG_BEDROCK_ENDPOINT_URL=
# Path to a custom CA bundle .pem file (leave blank for system default)
RAG_BEDROCK_CA_BUNDLE=
